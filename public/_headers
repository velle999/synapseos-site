/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'self'

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# The wiki is served at extensionless URLs (/wiki/Installation), which the
# /*.html rule above cannot match — a header rule tests the REQUEST path, and
# the request never carries the extension. Without this the pages fall through
# to /* and get whatever the platform's default is.
/wiki/*
  Cache-Control: public, max-age=0, must-revalidate

# Same reason, and these two matter more than most: Google's OAuth consent
# screen links to them, and a review that fetches a stale cached copy is a
# review that reads the wrong policy.
/privacy
  Cache-Control: public, max-age=0, must-revalidate

/terms
  Cache-Control: public, max-age=0, must-revalidate
